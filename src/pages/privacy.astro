---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('pages', 'privacy');
if (!entry) {
  throw new Error(
    'src/content/pages/privacy.md 가 없습니다. 문의 폼을 운영하려면 개인정보처리방침이 반드시 필요합니다.'
  );
}
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} noindex>
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h1 class="section__title">{entry.data.title}</h1>
      </div>
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>
