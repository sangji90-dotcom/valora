---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProseCalculator from '../components/ProseCalculator.astro';

const entry = await getEntry('pages', 'about');
if (!entry) {
  throw new Error(
    'src/content/pages/about.md 가 없습니다. 회사소개 페이지 본문 파일을 만들어주세요.'
  );
}
const { Content } = await render(entry);
---

{/*
  CMS에서 draft 로 둔 페이지는 주소를 지우지 않고 검색에서만 뺍니다.
  라우트가 사라지면 메뉴 링크가 404가 되어 오히려 알아채기 어렵습니다.
*/}
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  noindex={entry.data.draft}
>
  <section class="section">
    <div class="container">
      {
        entry.data.showHero && (
          <div class="section__head">
            <h1 class="section__title">{entry.data.title}</h1>
            {entry.data.description && (
              <p class="section__desc">{entry.data.description}</p>
            )}
          </div>
        )
      }
      <div class="prose">
        <Content />
      </div>
      {/* 본문에 계산기 블록이 있을 때만 동작합니다. 없으면 아무 일도 하지 않습니다 */}
      <ProseCalculator />
    </div>
  </section>
</BaseLayout>
