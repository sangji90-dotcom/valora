---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import siteConfig from '../../../../site.config';
import { getTerms } from '../../../lib/terms';
import { companyName, localeFromPath, localeParams, localePath, ps } from '../../../lib/i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductTabs from '../../../components/ProductTabs.astro';
import StickyInquiry from '../../../components/StickyInquiry.astro';
import ProseCalculator from '../../../components/ProseCalculator.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ProductImage from '../../../components/ProductImage.astro';
import {
  getPublishedProducts,
  getRelatedProducts,
  getCategoryLabel,
  getPriceView,
  statusLabel,
  productTitle,
  productSummary,
  getProductBodyEntry,
  productBadge,
  productSpecs,
} from '../../../lib/products';
import { breadcrumbSchema } from '../../../lib/structured-data';

/** 주소에서 언어를 읽어 화면 문구를 고릅니다 (i18n.ts 참고) */
const T = getTerms(localeFromPath(Astro.url.pathname));

const locale = localeFromPath(Astro.url.pathname);
/** 설정 본문에서 현재 언어를 꺼냅니다 (i18n.ts 의 Localized 참고) */
const S = (v: Parameters<typeof ps>[0]) => ps(v, locale);
/** 내부 링크에 언어 접두어를 붙입니다 (i18n.ts 참고) */
const L = (p: string) => localePath(p, localeFromPath(Astro.url.pathname));

export const getStaticPaths = (async () => {
  const products = await getPublishedProducts();
  /**
   * 언어 × 제품. 언어가 ko 하나면 지금과 똑같은 주소만 나옵니다.
   * 'en' 을 켜면 /en/products/<id>/ 가 함께 생깁니다.
   */
  return localeParams().flatMap(({ params, props }) =>
    products.map((product) => ({
      params: { ...params, id: product.id },
      props: { ...props, product },
    }))
  );
}) satisfies GetStaticPaths;

const { product } = Astro.props;
const { data } = product;
const title = productTitle(product, locale);
const summary = productSummary(product, locale);
/**
 * 본문은 <id>.en.md 가 있으면 그쪽을, 없으면 한국어를 씁니다.
 * ⚠ 영문 본문이 없다는 사실이 화면에는 드러나지 않습니다.
 *   공개 전에 무엇이 비어 있는지 확인하세요.
 */
const bodyEntry = await getProductBodyEntry(product, locale);
const { Content } = await render(bodyEntry);
const related = await getRelatedProducts(product);
const specEntries = productSpecs(data, locale);
const status = statusLabel(data.status, locale);
const price = getPriceView(data, locale);
const ratio = siteConfig.layout.imageRatio;

/**
 * 탭 구성.
 * 내용이 없는 탭은 아예 만들지 않습니다 — 눌렀더니 빈 화면이 나오는 것보다
 * 탭이 없는 편이 낫습니다.
 */
const notice = (siteConfig.productNotice?.items ?? []).map((n) => S(n));

const tabs: Array<{ id: 'detail' | 'specs' | 'notice'; label: string }> = [
  { id: 'detail' as const, label: T.ui.detailTab },
  ...(specEntries.length > 0 ? [{ id: 'specs' as const, label: T.specTab }] : []),
  ...(notice.length > 0
    ? [{ id: 'notice' as const, label: S(siteConfig.productNotice?.label) || T.ui.noticeTab }]
    : []),
];

// 구조화 데이터 — 구글 검색결과에 제품 카드로 노출될 수 있게 함
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: title,
  description: summary,
  category: getCategoryLabel(data.category, locale),
  brand: { '@type': 'Brand', name: companyName(locale) },
};

// 검색결과에 "제품 > 산업용 > 프로쉴드 900" 경로가 표시될 수 있게 함
const breadcrumb = breadcrumbSchema([
  { name: T.item, path: L('/products/') },
  { name: getCategoryLabel(data.category, locale), path: L(`/products/category/${data.category}/`) },
  { name: title, path: L(`/products/${product.id}/`) },
]);

---

<BaseLayout title={title} description={(locale === 'ko' && data.seoDescription) || summary}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumb)}
  />

  <div class="container detail">
    <nav class="crumb" aria-label={T.ui.currentLocation}>
      <a href={L("/products/")}>{T.item}</a>
      <span aria-hidden="true">/</span>
      <a href={L(`/products/category/${data.category}/`)}>
        {getCategoryLabel(data.category, locale)}
      </a>
      <span aria-hidden="true">/</span>
      <span>{title}</span>
    </nav>

    <div class="detail__top">
      <div class="detail__media" data-ratio={ratio}>
        <ProductImage
          image={data.thumbnail}
          alt={title}
          widths={[480, 760, 1040]}
          sizes="(max-width: 880px) 100vw, 560px"
          loading="eager"
          class="detail__img"
        />
        {
          data.gallery.length > 0 && (
            <div class="detail__thumbs">
              {data.gallery.map((img, i) => (
                <ProductImage
                  image={img}
                  alt={T.ui.detailImageAlt(title, i + 1)}
                  widths={[160, 320]}
                  sizes="120px"
                  loading="lazy"
                  class="detail__thumb"
                />
              ))}
            </div>
          )
        }
      </div>

      <div class="detail__info">
        <span class="badge">{getCategoryLabel(data.category, locale)}</span>
        {productBadge(data, locale) && <span class="badge badge--promo">{productBadge(data, locale)}</span>}
        {status && <span class="badge badge--status">{status}</span>}

        <h1 class="detail__title">{title}</h1>
        <p class="detail__summary">{summary}</p>

        <p class="detail__price">
          {
            price.listText && (
              <span class="detail__list-price">
                <span class="visually-hidden">{T.ui.listPrice}</span>
                {price.listText}
              </span>
            )
          }
          <span class="detail__price-now">
            {
              price.discount !== undefined && (
                <span class="detail__discount">{price.discount}%</span>
              )
            }
            {price.text}
          </span>
        </p>

        <div class="detail__actions">
          {/*
            어느 제품에 대한 문의인지 문의 페이지로 넘깁니다.
            이게 없으면 고객은 제품명을 다시 적어야 하고,
            고객사는 어느 제품 문의인지 알 수 없습니다.
          */}
          <a
            href={L(`/contact/?product=${encodeURIComponent(title)}`)}
            class="btn btn--primary"
          >
            {T.askThis}
          </a>
          {
            siteConfig.contact.phone && (
              <a href={`tel:${siteConfig.contact.phone.replace(/-/g, '')}`} class="btn btn--ghost">
                {siteConfig.contact.phone}
              </a>
            )
          }
        </div>

        {
          data.externalLinks.length > 0 && (
            <div class="buy">
              <h2 class="buy__label">{T.ui.buyLabel}</h2>
              <ul class="buy__list">
                {data.externalLinks.map((link) => (
                  <li>
                    {/*
                      외부 사이트로 나가는 링크입니다.
                      noopener 없이 target="_blank" 를 쓰면 열린 쪽에서
                      window.opener 로 이 페이지를 조작할 수 있습니다.
                      noreferrer 는 어디서 왔는지까지 넘기지 않습니다.
                    */}
                    <a
                      href={link.url}
                      class="buy__link"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {link.label}
                      <span class="visually-hidden">{T.ui.opensNewWindow}</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>

    {/*
      상세 설명 / 사양 / 유의사항을 탭으로 나눕니다.
      JS가 없으면 셋 다 제목과 함께 펼쳐진 채로 보입니다 — 내용이 사라지지 않습니다.
    */}
    <ProductTabs tabs={tabs} notice={notice}>
      <div slot="detail" class="detail__body prose">
        <Content />
      </div>

      {
        specEntries.length > 0 && (
          <table slot="specs" class="specs">
            <caption class="visually-hidden">{T.specCaption(title)}</caption>
            <tbody>
              {specEntries.map(([key, value]) => (
                <tr>
                  <th scope="row">{key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )
      }
    </ProductTabs>

    {/* 본문에 절감량 계산기를 넣은 제품이 있을 때만 동작합니다 */}
    <ProseCalculator />

    {/* 좁은 화면에서만 나오는 하단 고정 문의 바 */}
    <StickyInquiry productTitle={title} />

    {
      related.length > 0 && (
        <section class="section">
          <div class="section__head">
            <h2 class="section__title">{T.related}</h2>
          </div>
          <div class="related">
            {related.map((p) => (
              /* 관련 제품은 좁은 영역이라 프리셋과 무관하게 기본 카드로 고정합니다 */
              <ProductCard product={p} variant="card" />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .detail {
    padding-top: var(--space-8);
  }

  .crumb {
    display: flex;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .crumb a:hover {
    color: var(--color-accent);
  }

  .detail__top {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  /* prop으로 넘긴 class에는 scoped 해시가 붙지 않으므로 :global 필요 */
  .detail__media :global(.detail__img) {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-bg-muted);
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }


  /* 설정의 layout.imageRatio 가 있으면 기본 4:3 을 덮어씁니다 */
  [data-ratio='4:3'] :global(.detail__img) { aspect-ratio: 4 / 3; }
  [data-ratio='1:1'] :global(.detail__img) { aspect-ratio: 1 / 1; }
  [data-ratio='3:4'] :global(.detail__img) { aspect-ratio: 3 / 4; }
  [data-ratio='2:3'] :global(.detail__img) { aspect-ratio: 2 / 3; }
  [data-ratio='16:9'] :global(.detail__img) { aspect-ratio: 16 / 9; }

  .detail__thumbs {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-3);
    flex-wrap: wrap;
  }

  .detail__thumbs :global(.detail__thumb) {
    width: 96px;
    height: 72px;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .detail__title {
    font-size: var(--text-3xl);
    margin-block: var(--space-4) var(--space-3);
  }

  .detail__summary {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .detail__price {
    font-size: var(--text-xl);
    font-weight: 700;
    margin-bottom: var(--space-6);
  }

  .detail__list-price {
    display: block;
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .detail__price-now {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .detail__discount {
    color: var(--color-sale);
  }

  /* ---------- 외부 구매처 ---------- */

  .buy {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .buy__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3);
  }

  .buy__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .buy__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease);
  }

  .buy__link:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
  }

  .badge--promo {
    background: var(--color-accent);
    color: var(--color-accent-text);
    margin-left: var(--space-2);
  }

  .badge--status {
    background: var(--color-bg-muted);
    color: var(--color-text-muted);
    margin-left: var(--space-2);
  }

  .specs {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    margin-bottom: var(--space-8);
  }

  .specs th,
  .specs td {
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-3) var(--space-2);
    text-align: left;
    vertical-align: top;
  }

  .specs th {
    width: 34%;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .detail__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .detail__body {
    margin-top: var(--space-16);
  }

  .related {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-6);
  }

  @media (max-width: 880px) {
    .detail__top {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
