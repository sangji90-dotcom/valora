---
import { getTerms } from '../../../../lib/terms';
import { localeFromPath, localeParams, localePath, ps } from '../../../../lib/i18n';
import type { GetStaticPaths } from 'astro';
import siteConfig from '../../../../../site.config';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ProductBrowser from '../../../../components/ProductBrowser.astro';
import { getProductsByCategory } from '../../../../lib/products';
import { breadcrumbSchema } from '../../../../lib/structured-data';

/** 주소에서 언어를 읽어 화면 문구를 고릅니다 (i18n.ts 참고) */
const T = getTerms(localeFromPath(Astro.url.pathname));

/** 설정 본문에서 현재 언어를 꺼냅니다 (i18n.ts 의 Localized 참고) */
const S = (v: Parameters<typeof ps>[0]) => ps(v, localeFromPath(Astro.url.pathname));
/** 내부 링크에 언어 접두어를 붙입니다 (i18n.ts 참고) */
const L = (p: string) => localePath(p, localeFromPath(Astro.url.pathname));

/**
 * 카테고리별 URL을 정적으로 생성합니다.
 * 클라이언트 필터만 쓰면 카테고리 페이지가 검색엔진에 잡히지 않기 때문에,
 * SEO용 실제 URL을 별도로 만들어 둡니다.
 */
export const getStaticPaths = (() => {
  /** 언어 × 카테고리 */
  return localeParams().flatMap(({ params, props }) =>
    siteConfig.categories.map((category) => ({
      params: { ...params, category: category.id },
      props: { ...props, category },
    }))
  );
}) satisfies GetStaticPaths;

const { category } = Astro.props;
const products = await getProductsByCategory(category.id);

const breadcrumb = breadcrumbSchema([
  { name: T.item, path: L('/products/') },
  { name: S(category.label), path: L(`/products/category/${category.id}/`) },
]);
---

<BaseLayout
  title={S(category.label)}
  description={S(category.description) || T.categoryDesc(S(category.label))}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumb)}
  />
  <section class="section">
    <div class="container">
      <nav class="crumb" aria-label={T.ui.currentLocation}>
        <a href={L("/products/")}>{T.item}</a>
        <span aria-hidden="true">/</span>
        <span>{category.label}</span>
      </nav>

      <div class="section__head">
        <h1 class="section__title">{category.label}</h1>
        {category.description && <p class="section__desc">{category.description}</p>}
      </div>

      <ProductBrowser products={products} showFilter={false} />
    </div>
  </section>
</BaseLayout>

<style>
  .crumb {
    display: flex;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .crumb a:hover {
    color: var(--color-accent);
  }
</style>
