---
import type { GetStaticPaths } from 'astro';
import { getTerms } from '../../../lib/terms';
import { localeFromPath, localeParams } from '../../../lib/i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductBrowser from '../../../components/ProductBrowser.astro';
import { getPublishedProducts } from '../../../lib/products';

/** 주소에서 언어를 읽어 화면 문구를 고릅니다 (i18n.ts 참고) */
const T = getTerms(localeFromPath(Astro.url.pathname));

const products = await getPublishedProducts();

/**
 * 이 한 파일이 언어별 페이지를 전부 내보냅니다.
 * 기본 언어(ko)는 locale 이 undefined 라 접두어 없는 주소가 되고,
 * site.config 의 i18n.published 에 'en' 을 넣으면 /en/ 판본이 함께 생깁니다.
 */
export const getStaticPaths = (() => localeParams()) satisfies GetStaticPaths;

---

<BaseLayout
  title={T.item}
  description={T.listPageDesc}
>
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h1 class="section__title">{T.item}</h1>
        <p class="section__desc">
          {T.listPageLead}
        </p>
      </div>

      <ProductBrowser products={products} />
    </div>
  </section>
</BaseLayout>
