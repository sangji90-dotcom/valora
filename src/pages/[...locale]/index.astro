---
import type { GetStaticPaths } from 'astro';
import siteConfig from '../../../site.config';
import { getTerms } from '../../lib/terms';
import { localeFromPath, localeParams, localePath, ps } from '../../lib/i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ProductGrid from '../../components/ProductGrid.astro';
// 발로라는 지그재그 나열(FeaturedRows) 대신 한 화면에 하나씩 보여줍니다.
// FeaturedRows.astro 는 템플릿과 공유하므로 건드리지 않고 그대로 둡니다.
import FeaturedShowcase from '../../components/FeaturedShowcase.astro';
import PromoBanner from '../../components/PromoBanner.astro';
import ProofStrip from '../../components/ProofStrip.astro';
// StatBand 는 메인에서 내렸습니다 (요청서 11번) — ESG DATA 영역이 생기면 다시 씁니다
import SustainBand from '../../components/SustainBand.astro';
import ValoraSystem from '../../components/ValoraSystem.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Reveal from '../../components/Reveal.astro';
import { getFeaturedProducts, getCategoriesWithCount } from '../../lib/products';
import { organizationSchema } from '../../lib/structured-data';

/** 주소에서 언어를 읽어 화면 문구를 고릅니다 (i18n.ts 참고) */
const T = getTerms(localeFromPath(Astro.url.pathname));

/** 주소에서 읽은 현재 언어 */
const locale = localeFromPath(Astro.url.pathname);

const featured = await getFeaturedProducts();
const categories = await getCategoriesWithCount();

/**
 * 홈은 섹션 배열로 조립됩니다 (site.config.ts 의 layout.homeSections).
 * 순서를 바꾸거나 빼는 것만으로 고객사별 인상이 크게 달라집니다.
 */
const sections = siteConfig.layout.homeSections;
const { brandMessage } = siteConfig;

/**
 * 이 한 파일이 언어별 페이지를 전부 내보냅니다.
 * 기본 언어(ko)는 locale 이 undefined 라 접두어 없는 주소가 되고,
 * site.config 의 i18n.published 에 'en' 을 넣으면 /en/ 판본이 함께 생깁니다.
 */
export const getStaticPaths = (() => localeParams()) satisfies GetStaticPaths;


/**
 * 내부 링크에 언어 접두어를 붙입니다.
 * ⚠ 이걸 빠뜨리면 /en/ 페이지의 링크가 한국어 쪽으로 돌아갑니다.
 *   (빌드는 멀쩡히 통과합니다 — 눈으로만 잡히는 종류입니다)
 */
const L = (p: string) => localePath(p, localeFromPath(Astro.url.pathname));

/** 설정 본문에서 현재 언어를 꺼냅니다 (i18n.ts 의 Localized 참고) */
const S = (v: Parameters<typeof ps>[0]) => ps(v, localeFromPath(Astro.url.pathname));
---

<BaseLayout>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(organizationSchema(locale))}
  />

  <Hero />

  {/* 히어로 직후 — "이 회사 믿을 만한가"에 먼저 답합니다 */}
  <ProofStrip />

  {
    sections.map((section) => {
      if (section === 'message' && brandMessage) {
        return (
          <section class="section section--subtle">
            <div class="container message">
              <h2 class="message__title">{S(brandMessage.title)}</h2>
              <p class="message__body">{S(brandMessage.body)}</p>
            </div>
          </section>
        );
      }

      if (section === 'featured' && featured.length > 0) {
        return (
          <section class="section">
            <div class="container">
              <div class="section__head">
                <h2 class="section__title">{T.featuredTitle}</h2>
                <p class="section__desc">{T.featuredDesc}</p>
              </div>

              {siteConfig.layout.featured === 'rows' ? (
                <FeaturedShowcase products={featured} />
              ) : (
                <ProductGrid products={featured} />
              )}

              <div class="more">
                <a href={L("/products/")} class="btn btn--ghost">
                  {T.viewAll}
                </a>
              </div>
            </div>
          </section>
        );
      }

      if (section === 'categories' && categories.length > 0) {
        return (
          <section class="section section--subtle">
            <div class="container">
              <div class="section__head">
                <h2 class="section__title">{T.ui.categoriesTitle}</h2>
                <p class="section__desc">{T.categoriesDesc}</p>
              </div>
              <div class="cats">
                {categories.map((c) => (
                  <a href={L(`/products/category/${c.id}/`)} class="cat">
                    <span class="cat__label">{S(c.label)}</span>
                    <span class="cat__count">{T.countOf(c.count)}</span>
                    {c.description && <span class="cat__desc">{S(c.description)}</span>}
                  </a>
                ))}
              </div>
            </div>
          </section>
        );
      }

      if (section === 'promo' && siteConfig.promo) {
        return <PromoBanner />;
      }

      if (section === 'system') {
        return <ValoraSystem />;
      }

      if (section === 'howItWorks') {
        return <HowItWorks />;
      }

      if (section === 'sustainability') {
        return <SustainBand />;
      }

      if (section === 'cta') {
        return (
          <section class="section">
            <div class="container cta">
              <h2 class="cta__title">{T.ctaTitle}</h2>
              <p class="cta__desc">{T.ctaDesc}</p>
              <a href={L("/contact/")} class="btn btn--primary">
                {T.ui.contactCta}
              </a>
            </div>
          </section>
        );
      }

      return null;
    })
  }
  {/* 스크롤 등장 — [data-reveal] 이 붙은 요소에만 적용됩니다 */}
  <Reveal />
</BaseLayout>

<style>
  .more {
    display: flex;
    justify-content: center;
    margin-top: var(--space-8);
  }

  /* ---------- 브랜드 한마디 ---------- */

  .message {
    max-width: 720px;
    text-align: center;
  }

  .message__title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }

  .message__body {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.8;
    margin: 0;
    white-space: pre-line;
  }

  /* ---------- 카테고리 ---------- */

  .cats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
  }

  .cat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .cat:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .cat__label {
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .cat__count {
    font-size: var(--text-xs);
    color: var(--color-accent);
    font-weight: 600;
  }

  .cat__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  /* ---------- 문의 유도 ---------- */

  .cta {
    text-align: center;
    padding: var(--space-16) var(--space-6);
    background: var(--color-bg-muted);
    border-radius: var(--radius-lg);
  }

  .cta__title {
    font-size: var(--text-2xl);
  }

  .cta__desc {
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }
</style>
