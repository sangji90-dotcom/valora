---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProseCalculator from '../../components/ProseCalculator.astro';
import { localeParams, localeFromPath } from '../../lib/i18n';

const entry = await getEntry('pages', 'about');
if (!entry) {
  throw new Error(
    'src/content/pages/about.md 가 없습니다. 회사소개 페이지 본문 파일을 만들어주세요.'
  );
}
const locale = localeFromPath(Astro.url.pathname);
/** 영문 본문은 <id>.en.md 에 둡니다. 없으면 한국어 본문을 씁니다. */
const all = await getCollection('pages');
const bodyEntry =
  locale === 'ko' ? entry : (all.find((p) => p.id === `about.en`) ?? entry);
const pageTitle = (locale === 'en' && bodyEntry.data.titleEn) || bodyEntry.data.title;
const pageDesc =
  (locale === 'en' && bodyEntry.data.descriptionEn) || bodyEntry.data.description;
const { Content } = await render(bodyEntry);

/**
 * 이 한 파일이 언어별 페이지를 전부 내보냅니다.
 * 기본 언어(ko)는 locale 이 undefined 라 접두어 없는 주소가 되고,
 * site.config 의 i18n.published 에 'en' 을 넣으면 /en/ 판본이 함께 생깁니다.
 */
export const getStaticPaths = (() => localeParams()) satisfies GetStaticPaths;

---

{/*
  CMS에서 draft 로 둔 페이지는 주소를 지우지 않고 검색에서만 뺍니다.
  라우트가 사라지면 메뉴 링크가 404가 되어 오히려 알아채기 어렵습니다.
*/}
<BaseLayout
  title={pageTitle}
  description={pageDesc}
  noindex={entry.data.draft}
>
  <section class="section">
    <div class="container">
      {
        entry.data.showHero && (
          <div class="section__head">
            <h1 class="section__title">{pageTitle}</h1>
            {pageDesc && <p class="section__desc">{pageDesc}</p>}
          </div>
        )
      }
      <div class="prose">
        <Content />
      </div>
      {/* 본문에 계산기 블록이 있을 때만 동작합니다. 없으면 아무 일도 하지 않습니다 */}
      <ProseCalculator />
    </div>
  </section>
</BaseLayout>
