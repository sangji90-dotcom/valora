---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localeParams, localeFromPath } from '../../lib/i18n';

const entry = await getEntry('pages', 'privacy');
if (!entry) {
  throw new Error(
    'src/content/pages/privacy.md 가 없습니다. 문의 폼을 운영하려면 개인정보처리방침이 반드시 필요합니다.'
  );
}
const locale = localeFromPath(Astro.url.pathname);
/** 영문 본문은 <id>.en.md 에 둡니다. 없으면 한국어 본문을 씁니다. */
const all = await getCollection('pages');
const bodyEntry =
  locale === 'ko' ? entry : (all.find((p) => p.id === `privacy.en`) ?? entry);
const pageTitle = (locale === 'en' && bodyEntry.data.titleEn) || bodyEntry.data.title;
const pageDesc =
  (locale === 'en' && bodyEntry.data.descriptionEn) || bodyEntry.data.description;
const { Content } = await render(bodyEntry);

/**
 * 이 한 파일이 언어별 페이지를 전부 내보냅니다.
 * 기본 언어(ko)는 locale 이 undefined 라 접두어 없는 주소가 되고,
 * site.config 의 i18n.published 에 'en' 을 넣으면 /en/ 판본이 함께 생깁니다.
 */
export const getStaticPaths = (() => localeParams()) satisfies GetStaticPaths;

---

<BaseLayout title={pageTitle} description={pageDesc} noindex>
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h1 class="section__title">{pageTitle}</h1>
      </div>
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>
