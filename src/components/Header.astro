---
import siteConfig from '../../site.config';
import { getTerms } from '../lib/terms';
import { LOCALE_LABEL, hasMultipleLocales, companyName, localeFromPath, localePath, ps, publishedLocales, stripLocale } from '../lib/i18n';

/** 주소에서 읽은 현재 언어 */

/** 주소에서 언어를 읽어 화면 문구를 고릅니다 (i18n.ts 참고) */
const T = getTerms(localeFromPath(Astro.url.pathname));

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const utility = siteConfig.utilityNav;
const hasUtility = Boolean(utility?.left?.length || utility?.right?.length);

/**
 * 헤더 검색창은 /products/ 로 GET 이동합니다.
 * 검색 자체는 목록 페이지에서 처리하므로 여기에는 로직이 없습니다.
 */
const showSearch = siteConfig.enableSearch;

/**
 * 언어 전환 (요청서 3번 — 우측에 KR | EN).
 * ⚠ 언어가 하나뿐이면 아예 내보내지 않습니다. 눌러도 갈 곳이 없는
 *   버튼을 두면 404로 이어집니다.
 */
const here = localeFromPath(Astro.url.pathname);
const bare = stripLocale(Astro.url.pathname);
const langLinks = hasMultipleLocales()
  ? publishedLocales().map((l) => ({
      locale: l,
      label: LOCALE_LABEL[l],
      href: localePath(bare, l),
      current: l === here,
    }))
  : [];

/**
 * 내부 링크에 언어 접두어를 붙입니다.
 * ⚠ 이걸 빠뜨리면 /en/ 페이지의 링크가 한국어 쪽으로 돌아갑니다.
 *   (빌드는 멀쩡히 통과합니다 — 눈으로만 잡히는 종류입니다)
 */
const L = (p: string) => localePath(p, localeFromPath(Astro.url.pathname));

/** 설정 본문에서 현재 언어를 꺼냅니다 (i18n.ts 의 Localized 참고) */
const S = (v: Parameters<typeof ps>[0]) => ps(v, localeFromPath(Astro.url.pathname));
---

<header class="header">
  {
    hasUtility && (
      <div class="utility">
        <div class="container utility__inner">
          <nav class="utility__group" aria-label={T.ui.utilityMenu}>
            {(utility?.left ?? []).map((item) => (
              <a href={L(item.href)} class="utility__link">
                {S(item.label)}
              </a>
            ))}
          </nav>
          <nav class="utility__group" aria-label={T.ui.customerMenu}>
            {(utility?.right ?? []).map((item) => (
              <a href={L(item.href)} class="utility__link">
                {S(item.label)}
              </a>
            ))}

            {langLinks.length > 0 && (
              <span class="lang" role="group" aria-label={T.ui.languageSelect}>
                {langLinks.map((l) => (
                  <>
                    <a
                      href={l.href}
                      class="utility__link lang__link"
                      hreflang={l.locale}
                      lang={l.locale}
                      aria-current={l.current ? 'true' : undefined}
                    >
                      {l.label}
                    </a>
                  </>
                ))}
              </span>
            )}
          </nav>
        </div>
      </div>
    )
  }

  <div class="container header__inner">
    <a href={L("/")} class="header__logo" aria-label={T.ui.homeOf(companyName(here))}>
      {
        siteConfig.logo ? (
          <img src={siteConfig.logo} alt={companyName(here)} height="28" />
        ) : (
          <span>{companyName(here)}</span>
        )
      }
    </a>

    <input type="checkbox" id="nav-toggle" class="header__toggle visually-hidden" />
    <label for="nav-toggle" class="header__burger" aria-label={T.ui.menuOpen}>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </label>

    <nav class="header__nav" aria-label={T.ui.mainMenu}>
      {
        siteConfig.nav.map((item) => (
          <a
            href={L(item.href)}
            class:list={['header__link', { 'is-active': isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {S(item.label)}
          </a>
        ))
      }

      {
        showSearch && (
          <form class="header__search" action="/products/" method="get" role="search">
            <label for="header-q" class="visually-hidden">
              {T.searchLabel}
            </label>
            <input
              id="header-q"
              name="q"
              type="search"
              placeholder={T.searchLabel}
              autocomplete="off"
            />
            <button type="submit" aria-label={T.ui.searchButton}>
              <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
                <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="2" />
                <line
                  x1="13.5"
                  y1="13.5"
                  x2="18"
                  y2="18"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                />
              </svg>
            </button>
          </form>
        )
      }
    </nav>
  </div>

  {/* JS 없을 때 검색창을 숨기는 규칙은 public/noscript.css 에 있습니다 */}
</header>

<style>
  /* 언어 전환 — 요청서 3번 */
  .lang {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: var(--space-2);
  }

  /*
   * 언어 링크 사이 구분선.
   *
   * 전에는 "|" 글자를 넣었는데, 색이 --color-border 라 대비가
   * 1.15:1 이었습니다. 장식이라 aria-hidden 을 걸어두긴 했지만
   * 그건 "안 읽히게" 할 뿐이고, 눈으로도 거의 안 보이는 상태였습니다.
   * 글자를 지우고 경계선으로 그립니다 — 대비 검사 대상에서 빠지고
   * 실제로는 더 잘 보입니다.
   */
  .lang__link + .lang__link {
    padding-left: var(--space-2);
    border-left: 1px solid var(--color-border);
  }

  .lang__link[aria-current='true'] {
    font-weight: 700;
    color: var(--color-text);
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  /* ---------- 상단 유틸바 ---------- */

  .utility {
    background: var(--color-bg-subtle);
    border-bottom: 1px solid var(--color-border);
  }

  .utility__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    min-height: 34px;
  }

  .utility__group {
    display: flex;
    gap: var(--space-4);
  }

  .utility__link {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    transition: color var(--dur) var(--ease);
  }

  .utility__link:hover {
    color: var(--color-text);
  }

  /* 좁은 화면에서는 줄을 통째로 접습니다 (주 메뉴만 남김) */
  @media (max-width: 720px) {
    .utility {
      display: none;
    }
  }

  /* ---------- 주 헤더 ---------- */

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    gap: var(--space-4);
  }

  .header__logo {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .header__link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    padding-block: var(--space-2);
    transition: color var(--dur) var(--ease);
    white-space: nowrap;
  }

  .header__link:hover,
  .header__link.is-active {
    color: var(--color-text);
  }

  .header__link.is-active {
    font-weight: 600;
  }

  /* ---------- 헤더 검색 ---------- */

  .header__search {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-bg);
  }

  .header__search:focus-within {
    border-color: var(--color-accent);
  }

  .header__search input {
    font: inherit;
    font-size: var(--text-sm);
    width: 140px;
    padding-block: var(--space-2);
    border: 0;
    background: transparent;
    color: var(--color-text);
  }

  .header__search input:focus {
    outline: none;
  }

  .header__search button {
    display: flex;
    align-items: center;
    padding: var(--space-1);
    border: 0;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .header__search button:hover {
    color: var(--color-text);
  }

  /* ---------- 모바일 ---------- */

  .header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: var(--space-2);
    cursor: pointer;
    border-radius: var(--radius-sm);
  }

  .header__burger span {
    display: block;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
  }

  /* JS 없이 CSS만으로 모바일 메뉴 동작 (정적 사이트 원칙 유지) */
  @media (max-width: 720px) {
    .header__burger {
      display: flex;
    }

    .header__nav {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      padding: var(--space-2) var(--container-pad) var(--space-4);
      display: none;
    }

    .header__toggle:checked ~ .header__nav {
      display: flex;
    }

    .header__link {
      padding-block: var(--space-3);
      font-size: var(--text-base);
    }

    .header__search {
      margin-top: var(--space-3);
    }

    .header__search input {
      width: 100%;
    }
  }

  @media print {
    .utility,
    .header__search,
    .header__burger {
      display: none;
    }
  }
</style>
