---
/**
 * ============================================================
 *  제품 상세 탭 — 동작과 모양
 * ============================================================
 *  국내 쇼핑몰의 상세 페이지 관례를 따릅니다.
 *  상세 설명과 사양이 한 줄로 이어지면, 사양 하나 확인하려고
 *  본문 전체를 스크롤해야 합니다.
 *
 *  설계 원칙 — **JS 없이도 전부 읽혀야 합니다.**
 *  HTML은 "제목 + 내용"이 차례로 나열된 평범한 문서입니다.
 *  스크립트가 그것을 탭으로 접습니다. 스크립트가 막히거나 실패하면
 *  모든 내용이 펼쳐진 채로 보일 뿐, 사라지지 않습니다.
 *
 *  접근성 — 탭 키보드 조작은 WAI-ARIA 관행을 따릅니다.
 *    ← → : 이전/다음 탭
 *    Home / End : 처음/마지막 탭
 *  탭 버튼만 Tab 키 순서에 들어가고(roving tabindex), 선택된 패널
 *  내용은 그대로 탐색됩니다.
 * ============================================================
 */

interface Props {
  /** 표시할 탭. 내용이 없는 탭은 호출부에서 빼세요 */
  tabs: Array<{ id: 'detail' | 'specs' | 'notice'; label: string }>;
  /**
   * 유의사항 항목. 슬롯이 아니라 값으로 받습니다 —
   * 슬롯으로 넘기면 여기 스타일(scoped)이 그 마크업에 안 붙습니다.
   */
  notice?: string[];
}

const { tabs, notice = [] } = Astro.props;
const has = (id: string) => tabs.some((t) => t.id === id);
---

<div class="tabs" data-tabs>
  {/*
    탭 줄은 처음에 hidden 입니다. 스크립트가 돌 때만 드러납니다.
    JS가 없으면 누를 수 없는 버튼만 남아 혼란을 주기 때문입니다.
  */}
  <div class="tabs__list" role="tablist" aria-label="제품 정보" hidden data-tabs-list>
    {tabs.map((t, i) => (
      <button
        type="button"
        class="tabs__tab"
        role="tab"
        id={`tab-${t.id}`}
        aria-controls={`panel-${t.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        data-tab={t.id}
      >
        {t.label}
      </button>
    ))}
  </div>

  {
    has('detail') && (
      <section class="tabs__panel" id="panel-detail" aria-labelledby="tab-detail" data-panel="detail">
        <h2 class="tabs__heading" data-tabs-heading>
          {tabs.find((t) => t.id === 'detail')?.label}
        </h2>
        <slot name="detail" />
      </section>
    )
  }

  {
    has('specs') && (
      <section class="tabs__panel" id="panel-specs" aria-labelledby="tab-specs" data-panel="specs">
        <h2 class="tabs__heading" data-tabs-heading>
          {tabs.find((t) => t.id === 'specs')?.label}
        </h2>
        <slot name="specs" />
      </section>
    )
  }

  {
    has('notice') && (
      <section class="tabs__panel" id="panel-notice" aria-labelledby="tab-notice" data-panel="notice">
        <h2 class="tabs__heading" data-tabs-heading>
          {tabs.find((t) => t.id === 'notice')?.label}
        </h2>
        <ul class="tabs__notice">
          {notice.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </section>
    )
  }
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const list = root.querySelector<HTMLElement>('[data-tabs-list]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];

    // 탭이 하나뿐이면 접을 이유가 없습니다 — 그대로 둡니다
    if (!list || tabs.length < 2 || panels.length !== tabs.length) continue;

    // 여기까지 왔다는 건 스크립트가 도는 환경이라는 뜻이므로 탭 줄을 드러냅니다
    list.hidden = false;

    // 패널 안의 제목은 탭 버튼과 중복되므로 감춥니다.
    // (JS가 없으면 이 줄이 실행되지 않아 제목이 그대로 남습니다)
    for (const h of root.querySelectorAll<HTMLElement>('[data-tabs-heading]')) {
      h.hidden = true;
    }

    const select = (index: number, focus = true) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, false));

      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        let next: number | null = null;

        if (e.key === 'ArrowRight') next = i === last ? 0 : i + 1;
        else if (e.key === 'ArrowLeft') next = i === 0 ? last : i - 1;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = last;

        if (next !== null) {
          e.preventDefault();
          select(next);
        }
      });
    });

    select(0, false);
  }
</script>

<style>
  .tabs {
    margin-top: var(--space-8);
  }

  .tabs__list {
    display: flex;
    gap: var(--space-1);
    border-bottom: 1px solid var(--color-border);
    overflow-x: auto;
    /* 좁은 화면에서 탭이 넘칠 때 가로로 밀리게 하되 스크롤바는 숨깁니다 */
    scrollbar-width: none;
  }

  .tabs__list::-webkit-scrollbar {
    display: none;
  }

  .tabs__tab {
    flex: 0 0 auto;
    padding: var(--space-3) var(--space-5);
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    font: inherit;
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
    white-space: nowrap;
  }

  .tabs__tab:hover {
    color: var(--color-text);
  }

  .tabs__tab[aria-selected='true'] {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }

  .tabs__tab:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .tabs__panel {
    padding-top: var(--space-6);
  }

  /* JS가 없을 때 — 패널마다 제목이 보이고 전부 펼쳐집니다 */
  .tabs__heading {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xl);
  }

  .tabs__notice {
    margin: 0;
    padding-left: var(--space-5);
    line-height: 1.8;
  }

  .tabs__notice li + li {
    margin-top: var(--space-2);
  }
</style>
