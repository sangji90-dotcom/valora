---
import siteConfig from '../../site.config';
import { localeFromPath, ps } from '../lib/i18n';

/**
 * ============================================================
 *  BRAND STORY — 발로라 전용 (요청서 14번)
 * ============================================================
 *  ⚠ 이 컴포넌트는 발로라에만 있습니다. 템플릿에는 넣지 마세요.
 *
 *  "왜 이 제품이 생겼는가" 한 자리입니다.
 *
 *  ⚠ 창업자 서사·인물 사진·수상 이력을 넣지 마세요.
 *    확인된 사실이 아니면 브랜드 스토리가 아니라 그냥 주장입니다.
 *
 *  왼쪽 큰 한 문장 + 오른쪽 본문. 두 칸으로 나눈 이유는,
 *  문단만 이어 붙이면 회사소개 페이지와 똑같아 보여서
 *  메인에 또 둘 이유가 없어지기 때문입니다.
 * ============================================================
 */

const story = siteConfig.brandStory;

/** 설정 본문에서 현재 언어를 꺼냅니다 (i18n.ts 의 Localized 참고) */
const S = (v: Parameters<typeof ps>[0]) => ps(v, localeFromPath(Astro.url.pathname));
---

{
  story && story.body.length > 0 && (
    <section class="story section" id="story" aria-label={S(story.title)}>
      <div class="container story__grid">
        <div class="story__lead" data-reveal>
          <p class="story__eyebrow">{S(story.title)}</p>
          {/* 줄바꿈은 설정 문자열의 \n 을 그대로 따릅니다 */}
          <p class="story__pull">{S(story.pull)}</p>
        </div>

        <div class="story__body" data-reveal>
          {story.body.map((para) => (
            <p class="story__para">{S(para)}</p>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .story__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-12);
    align-items: start;
  }

  .story__eyebrow {
    margin: 0 0 var(--space-5);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
  }

  .story__pull {
    margin: 0;
    font-size: var(--text-2xl);
    line-height: 1.45;
    letter-spacing: var(--tracking-tight);
    /* 설정에 넣은 줄바꿈을 살립니다 */
    white-space: pre-line;
    /* 한글은 어절 단위로 끊어야 읽힙니다 */
    word-break: keep-all;
  }

  .story__body {
    display: grid;
    gap: var(--space-5);
  }

  .story__para {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.85;
    word-break: keep-all;
  }

  /* 첫 문단만 조금 진하게 — 어디서부터 읽으면 되는지 표시 */
  .story__para:first-child {
    color: var(--color-text);
  }

  @media (max-width: 880px) {
    .story__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .story__pull {
      font-size: var(--text-xl);
    }
  }
</style>
