---
import siteConfig from '../../site.config';
import { localeFromPath, ps } from '../lib/i18n';

/**
 * ============================================================
 *  지속가능성 3원칙 — 발로라 전용
 * ============================================================
 *  ⚠ 이 컴포넌트는 발로라에만 있습니다. 템플릿에는 넣지 마세요.
 *
 *  요청서 11번이 바꿔 달라고 한 자리입니다.
 *  전에는 여기에 80kg / 216~280kg / 20~30% 가 크게 들어가 있었습니다.
 *
 *  ⚠ 여기에는 숫자를 쓰지 마세요.
 *    검증되지 않은 환경 수치를 크게 쓰면 부당 표시가 됩니다.
 *    절감량은 산정근거를 확보한 뒤 별도 ESG DATA 영역으로 나갑니다
 *    (site.config.ts 의 stats 는 그때 쓰려고 남겨두었습니다).
 *
 *  대신 **제품이 생긴 방식**을 말합니다. 숫자가 없어도 구조는
 *  반박할 수 없고, 나중에 근거가 붙으면 그 위에 얹으면 됩니다.
 * ============================================================
 */

const s = siteConfig.sustainability;

/** 설정 본문에서 현재 언어를 꺼냅니다 (i18n.ts 의 Localized 참고) */
const S = (v: Parameters<typeof ps>[0]) => ps(v, localeFromPath(Astro.url.pathname));
---

{
  s && s.items.length > 0 && (
    <section class="sus" id="sustainability" aria-label={S(s.title)}>
      <div class="container">
        <div class="sus__head" data-reveal>
          <h2 class="sus__title">{S(s.title)}</h2>
          {s.lead && <p class="sus__lead">{S(s.lead)}</p>}
        </div>

        <div class="sus__grid">
          {s.items.map((item) => (
            <article class="sus__item" data-reveal>
              <p class="sus__key">{item.key}</p>
              <h3 class="sus__label">{S(item.label)}</h3>
              <p class="sus__body">{S(item.body)}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .sus {
    padding-block: var(--space-24);
    background: linear-gradient(180deg, var(--color-bg-subtle), var(--color-bg));
    border-block: 1px solid var(--color-border);
  }

  .sus__head {
    margin-bottom: var(--space-12);
    max-width: 40rem;
  }

  .sus__title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .sus__lead {
    margin: 0;
    color: var(--color-text-muted);
  }

  .sus__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: var(--space-8);
  }

  .sus__item {
    padding: var(--space-8) var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  /* 영문 키워드 — 대문자 라벨이 브랜드 톤을 만듭니다 */
  .sus__key {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
  }

  .sus__label {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
  }

  .sus__body {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  @media (max-width: 880px) {
    .sus {
      padding-block: var(--space-16);
    }

    .sus__head {
      margin-bottom: var(--space-8);
    }

    .sus__title {
      font-size: var(--text-2xl);
    }

    .sus__item {
      padding: var(--space-6) var(--space-5);
    }
  }
</style>
