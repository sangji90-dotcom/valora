---
import siteConfig from '../../site.config';
import { localeFromPath, localePath, ps } from '../lib/i18n';
import { getTerms } from '../lib/terms';

/** 주소에서 언어를 읽어 화면 문구를 고릅니다 (i18n.ts 참고) */
const T = getTerms(localeFromPath(Astro.url.pathname));

/**
 * 화면 우측에 고정되는 퀵 메뉴.
 * 국내 쇼핑몰에서 흔한 형태로, 어디서든 문의·전화로 바로 가게 합니다.
 *
 * 설계 원칙
 *  - "{T.ui.topOfPage}"는 스크롤을 내렸을 때만 나타납니다. JS가 없으면
 *    항상 보이게 두어(#top 앵커) 기능이 사라지지 않게 했습니다.
 *  - 좁은 화면에서는 본문을 가리므로 하단 가로 막대로 바뀝니다.
 *  - 인쇄 시에는 나오지 않습니다.
 */
const links = siteConfig.quickLinks ?? [];

/**
 * 내부 링크에 언어 접두어를 붙입니다.
 * ⚠ 이걸 빠뜨리면 /en/ 페이지의 링크가 한국어 쪽으로 돌아갑니다.
 *   (빌드는 멀쩡히 통과합니다 — 눈으로만 잡히는 종류입니다)
 */
const L = (p: string) => localePath(p, localeFromPath(Astro.url.pathname));

/** 설정 본문에서 현재 언어를 꺼냅니다 (i18n.ts 의 Localized 참고) */
const S = (v: Parameters<typeof ps>[0]) => ps(v, localeFromPath(Astro.url.pathname));
---

{
  links.length > 0 && (
    <nav class="quick" aria-label={T.ui.quickMenu}>
      <ul class="quick__list">
        {links.map((item) => (
          <li>
            <a href={L(item.href)} class="quick__link">
              {S(item.label)}
            </a>
          </li>
        ))}
        <li>
          <a href="#main" class="quick__link quick__link--top" data-to-top>
            {T.ui.topOfPage}
          </a>
        </li>
      </ul>
    </nav>
  )
}

<script>
  // 스크롤을 조금이라도 내렸을 때만 "{T.ui.topOfPage}"를 보여줍니다.
  const topLink = document.querySelector<HTMLElement>('[data-to-top]');
  if (topLink) {
    const parent = topLink.parentElement;
    const sync = () => {
      if (parent) parent.hidden = window.scrollY < 300;
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });

    topLink.addEventListener('click', (e) => {
      e.preventDefault();
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      // 포커스를 본문 맨 앞으로 되돌려 키보드 사용자가 길을 잃지 않게 합니다
      document.querySelector<HTMLElement>('#main')?.focus?.();
    });
  }
</script>

<style>
  .quick {
    position: fixed;
    right: var(--space-4);
    /*
     * 화면 중앙이 아니라 오른쪽 아래에 둡니다.
     * 중앙에 두면 캐러셀의 다음 화살표와 정확히 겹칩니다.
     */
    bottom: var(--space-8);
    z-index: 40;
  }

  .quick__list {
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg);
    box-shadow: var(--shadow-md);
  }

  .quick__list > li + li .quick__link {
    border-top: 1px solid var(--color-border);
  }

  .quick__link {
    display: flex;
    align-items: center;
    justify-content: center;
    /* 한글은 글자 단위로 끊겨 "제품 문/의" 처럼 잘립니다. 어절 단위로 묶습니다 */
    word-break: keep-all;
    width: 80px;
    min-height: 62px;
    padding: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
    color: var(--color-text-muted);
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .quick__link:hover {
    background: var(--color-accent-subtle);
    color: var(--color-text);
  }

  .quick__link--top {
    min-height: 44px;
  }

  /* 좁은 화면 — 옆에 띄우면 본문을 가리므로 아래 가로 막대로 */
  @media (max-width: 880px) {
    /* 하단 고정 막대가 푸터 마지막 줄을 가리지 않도록 자리를 비워둡니다 */
    :global(body) {
      padding-bottom: 48px;
    }

    .quick {
      right: 0;
      left: 0;
      bottom: 0;
    }

    .quick__list {
      flex-direction: row;
      border-radius: 0;
      border-inline: 0;
      border-bottom: 0;
    }

    .quick__list > li {
      flex: 1;
    }

    .quick__list > li + li .quick__link {
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }

    .quick__link {
      width: auto;
      min-height: 48px;
    }
  }

  @media print {
    .quick {
      display: none;
    }
  }
</style>
