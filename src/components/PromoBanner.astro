---
import siteConfig from '../../site.config';

/**
 * 기획전 배너 + 인기 검색어.
 *
 * 인기 검색어는 /products/?q=... 로 이동합니다.
 * 검색 자체는 목록 페이지가 처리하므로 여기에는 로직이 없고,
 * 링크만 만들면 되므로 JS 없이도 동작합니다.
 *
 * 이미지는 public/ 의 파일을 그대로 씁니다(빌드 최적화 없음).
 * 배너는 고객사가 직접 자주 갈아끼우는 자리라, 파일만 덮어쓰면
 * 끝나도록 일부러 단순하게 뒀습니다. 미리 알맞은 크기로 줄여서 올리세요.
 */
const promo = siteConfig.promo;
---

{
  promo && (
    <section class="section">
      <div class="container">
        <a class="promo" href={promo.href} data-has-image={promo.image ? 'true' : 'false'}>
          {promo.image && <img class="promo__img" src={promo.image} alt="" loading="lazy" />}

          <div class="promo__body">
            <h2 class="promo__title">{promo.title}</h2>
            {promo.description && <p class="promo__desc">{promo.description}</p>}
            <span class="promo__cta">{promo.cta ?? '보러 가기'}</span>
          </div>
        </a>

        {promo.keywords && promo.keywords.length > 0 && (
          <div class="keywords">
            <h3 class="keywords__label">인기 검색어</h3>
            <ul class="keywords__list">
              {promo.keywords.map((word) => (
                <li>
                  <a class="keyword" href={`/products/?q=${encodeURIComponent(word)}`}>
                    {word}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .promo {
    position: relative;
    display: block;
    min-height: 220px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-accent-subtle);
  }

  .promo__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .promo__body {
    position: relative;
    padding: var(--space-12) var(--space-8);
    max-width: 560px;
  }

  /* 사진 위에 글자를 얹을 때만 가독성 보호막을 깝니다 */
  .promo[data-has-image='true'] .promo__body {
    color: #fff;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.62) 0%,
      rgba(0, 0, 0, 0.42) 65%,
      transparent 100%
    );
    max-width: 640px;
  }

  .promo__title {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-3);
    color: inherit;
  }

  .promo__desc {
    margin: 0 0 var(--space-5);
    opacity: 0.88;
  }

  .promo__cta {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 700;
    padding-bottom: 2px;
    border-bottom: 2px solid currentColor;
  }

  .promo:hover .promo__cta {
    opacity: 0.75;
  }

  /* ---------- 인기 검색어 ---------- */

  .keywords {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .keywords__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin: 0;
  }

  .keywords__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .keyword {
    display: inline-block;
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .keyword:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .promo__body {
      padding: var(--space-8) var(--space-5);
    }

    /* 좁은 화면에서는 가로 그라데이션이 글자를 덮지 못해 세로로 바꿉니다 */
    .promo[data-has-image='true'] .promo__body {
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.3) 0%,
        rgba(0, 0, 0, 0.62) 100%
      );
    }
  }
</style>
