---
import siteConfig from '../../site.config';
import { localeFromPath, ps } from '../lib/i18n';

/**
 * ============================================================
 *  TECHNOLOGY — 발로라 전용 (요청서 10번)
 * ============================================================
 *  ⚠ 이 컴포넌트는 발로라에만 있습니다. 템플릿에는 넣지 마세요.
 *
 *  ProofStrip 과 역할이 다릅니다.
 *    ProofStrip = "이 회사 믿을 만한가"  (자격 — 히어로 바로 아래)
 *    여기       = "무엇이 그걸 가능하게 하나" (원리)
 *  자격을 여기서 또 크게 쓰면 같은 말을 두 번 하게 되므로,
 *  출원번호·인증 상태는 아래 한 줄짜리 근거 목록으로만 둡니다.
 *
 *  ⚠ 특허는 **출원**입니다. 등록이 아닙니다.
 *    '특허 획득/취득' 으로 고치면 허위표시가 됩니다.
 *    disclaimer 를 지우지 마세요.
 * ============================================================
 */

const tech = siteConfig.technology;

/** 설정 본문에서 현재 언어를 꺼냅니다 (i18n.ts 의 Localized 참고) */
const S = (v: Parameters<typeof ps>[0]) => ps(v, localeFromPath(Astro.url.pathname));
---

{
  tech && tech.items.length > 0 && (
    <section class="tech section section--subtle" id="technology" aria-label={S(tech.title)}>
      <div class="container">
        <div class="section__head" data-reveal>
          <h2 class="section__title">{S(tech.title)}</h2>
          {tech.lead && <p class="section__desc">{S(tech.lead)}</p>}
        </div>

        <div class="tech__grid">
          {tech.items.map((item) => (
            <article class="tech__item" data-reveal>
              <p class="tech__key">{item.key}</p>
              <h3 class="tech__label">{S(item.label)}</h3>
              <p class="tech__body">{S(item.body)}</p>
            </article>
          ))}
        </div>

        {tech.credentials && tech.credentials.length > 0 && (
          <ul class="tech__creds" data-reveal>
            {tech.credentials.map((c) => (
              <li class="tech__cred">{S(c)}</li>
            ))}
          </ul>
        )}

        {tech.disclaimer && <p class="tech__disclaimer">{S(tech.disclaimer)}</p>}
      </div>
    </section>
  )
}

<style>
  .tech__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-6);
  }

  .tech__item {
    padding: var(--space-6) var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .tech__key {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
  }

  .tech__label {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
  }

  .tech__body {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.75;
    word-break: keep-all;
  }

  /* ---------- 근거 ---------- */

  .tech__creds {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-8) 0 0;
    padding: var(--space-5) var(--space-6);
    list-style: none;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .tech__cred {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    word-break: keep-all;
  }

  .tech__disclaimer {
    margin: var(--space-4) 0 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    word-break: keep-all;
  }

  @media (max-width: 880px) {
    .tech__item {
      padding: var(--space-6) var(--space-5);
    }

    .tech__creds {
      gap: var(--space-3);
      margin-top: var(--space-8);
    }
  }
</style>
