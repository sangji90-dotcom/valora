---
import siteConfig from '../../site.config';
import { getTerms } from '../lib/terms';
import { companyName, localeFromPath, localePath, ps } from '../lib/i18n';
import ProductImage from './ProductImage.astro';
import HeroCarousel from './HeroCarousel.astro';
import { getCategoriesWithCount, getFeaturedProducts, productTitle } from '../lib/products';

/** 주소에서 읽은 현재 언어 */
const locale = localeFromPath(Astro.url.pathname);

/** 주소에서 언어를 읽어 화면 문구를 고릅니다 (i18n.ts 참고) */
const T = getTerms(localeFromPath(Astro.url.pathname));

/** 설정 본문에서 현재 언어를 꺼냅니다 (i18n.ts 의 Localized 참고) */
const S = (v: Parameters<typeof ps>[0]) => ps(v, localeFromPath(Astro.url.pathname));

/**
 * 홈 히어로. 구조는 site.config.ts의 layout.hero 가 정합니다.
 * 색·서체는 tokens.css가, 구조는 여기가 담당합니다.
 */
const variant = siteConfig.layout.hero;

// split 변형은 대표 제품 이미지를 씁니다. 상품이 없으면 stacked로 자동 강등됩니다.
const featured = variant === 'split' ? await getFeaturedProducts(1) : [];
const showcase = featured[0];
const effective = variant === 'split' && !showcase ? 'stacked' : variant;

/**
 * 히어로에서 바로 "누구를 위한 것인지" 를 보여줍니다 (요청서 4번).
 * 카테고리를 그대로 씁니다 — 따로 적어두면 카테고리를 고칠 때
 * 여기만 옛날 값으로 남습니다.
 * 상품이 없는 카테고리는 getCategoriesWithCount 가 이미 걸러냅니다.
 */
const audiences = await getCategoriesWithCount();

/**
 * 첫 화면 문구. heroLead 가 비어 있으면 SEO description 으로 떨어집니다.
 * ⚠ description 은 검색결과용 긴 문장이라, 첫 화면에서 그대로 읽히면
 *   아무도 끝까지 안 읽습니다. heroLead 를 채우는 쪽이 낫습니다.
 */
const lead = S(siteConfig.heroLead) || S(siteConfig.description);

/** 내부 링크에 언어 접두어를 붙입니다 (i18n.ts 참고) */
const L = (p: string) => localePath(p, localeFromPath(Astro.url.pathname));
---

{variant === 'carousel' && <HeroCarousel />}

{variant !== 'carousel' && (
<section class="hero" data-variant={effective}>
  <div class="container hero__inner">
    <div class="hero__body">
      <p class="badge">{companyName(locale)}</p>
      <h1 class="hero__title">{S(siteConfig.tagline)}</h1>
      <p class="hero__desc">{lead}</p>
      <div class="hero__actions">
        <a href={L("/products/")} class="btn btn--primary">{T.viewItems}</a>
        <a href={L("/contact/")} class="btn btn--ghost">{T.ui.contactCta}</a>
      </div>

      {
        audiences.length > 0 && (
          <ul class="hero__for" aria-label={T.ui.categoriesTitle}>
            {audiences.map((c) => (
              <li>
                <a class="hero__forItem" href={L(`/products/category/${c.id}/`)}>
                  {S(c.label)}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {
      effective === 'split' && showcase && (
        <div class="hero__media">
          <ProductImage
            image={showcase.data.thumbnail}
            alt={productTitle(showcase, locale)}
            widths={[480, 760, 1040]}
            sizes="(max-width: 880px) 100vw, 520px"
            loading="eager"
            class="hero__img"
          />
        </div>
      )
    }
  </div>
</section>
)}

<style>
  .hero {
    padding-block: var(--space-24) var(--space-16);
  }

  .hero__title {
    font-size: var(--text-4xl);
    margin-block: var(--space-4);
  }

  .hero__desc {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* ---------- 누구를 위한 것인가 ---------- */

  .hero__for {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: var(--space-8) 0 0;
    padding: var(--space-5) 0 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .hero__forItem {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding: var(--space-1) 0;
  }

  /* 항목 사이 구분점 — 칩으로 만들면 위의 버튼과 경쟁합니다 */
  .hero__for li + li .hero__forItem::before {
    content: '·';
    margin-right: var(--space-3);
    opacity: 0.5;
  }

  .hero__forItem:hover,
  .hero__forItem:focus-visible {
    color: var(--color-text);
  }

  /* ---------- stacked : 문구 위주 + 그라데이션 ---------- */

  .hero[data-variant='stacked'] {
    background: linear-gradient(
      180deg,
      var(--color-accent-subtle) 0%,
      var(--color-bg) 100%
    );
  }

  .hero[data-variant='stacked'] .hero__body {
    max-width: 720px;
  }

  /* ---------- split : 좌측 문구 + 우측 제품 이미지 ---------- */

  .hero[data-variant='split'] {
    background: var(--color-bg-subtle);
    border-bottom: 1px solid var(--color-border);
  }

  .hero[data-variant='split'] .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hero__media {
    min-width: 0;
  }

  /* prop으로 넘긴 class에는 scoped 해시가 붙지 않으므로 :global 필요 */
  .hero__media :global(.hero__img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  /* ---------- minimal : 큰 타이포만 ---------- */

  .hero[data-variant='minimal'] {
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-24) var(--space-16);
  }

  .hero[data-variant='minimal'] .hero__body {
    max-width: 900px;
  }

  .hero[data-variant='minimal'] .badge {
    background: transparent;
    padding: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero[data-variant='minimal'] .hero__title {
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    letter-spacing: -0.03em;
  }

  .hero[data-variant='minimal'] .hero__desc {
    max-width: 52ch;
  }

  @media (max-width: 880px) {
    .hero[data-variant='split'] .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .hero {
      padding-block: var(--space-16) var(--space-12);
    }
  }
</style>
