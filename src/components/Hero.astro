---
import siteConfig from '../../site.config';
import T from '../lib/terms';
import ProductImage from './ProductImage.astro';
import HeroCarousel from './HeroCarousel.astro';
import { getFeaturedProducts } from '../lib/products';

/**
 * 홈 히어로. 구조는 site.config.ts의 layout.hero 가 정합니다.
 * 색·서체는 tokens.css가, 구조는 여기가 담당합니다.
 */
const variant = siteConfig.layout.hero;

// split 변형은 대표 제품 이미지를 씁니다. 상품이 없으면 stacked로 자동 강등됩니다.
const featured = variant === 'split' ? await getFeaturedProducts(1) : [];
const showcase = featured[0];
const effective = variant === 'split' && !showcase ? 'stacked' : variant;
---

{variant === 'carousel' && <HeroCarousel />}

{variant !== 'carousel' && (
<section class="hero" data-variant={effective}>
  <div class="container hero__inner">
    <div class="hero__body">
      <p class="badge">{siteConfig.company}</p>
      <h1 class="hero__title">{siteConfig.tagline}</h1>
      <p class="hero__desc">{siteConfig.description}</p>
      <div class="hero__actions">
        <a href="/products/" class="btn btn--primary">{T.viewItems}</a>
        <a href="/contact/" class="btn btn--ghost">문의하기</a>
      </div>
    </div>

    {
      effective === 'split' && showcase && (
        <div class="hero__media">
          <ProductImage
            image={showcase.data.thumbnail}
            alt={showcase.data.title}
            widths={[480, 760, 1040]}
            sizes="(max-width: 880px) 100vw, 520px"
            loading="eager"
            class="hero__img"
          />
        </div>
      )
    }
  </div>
</section>
)}

<style>
  .hero {
    padding-block: var(--space-24) var(--space-16);
  }

  .hero__title {
    font-size: var(--text-4xl);
    margin-block: var(--space-4);
  }

  .hero__desc {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* ---------- stacked : 문구 위주 + 그라데이션 ---------- */

  .hero[data-variant='stacked'] {
    background: linear-gradient(
      180deg,
      var(--color-accent-subtle) 0%,
      var(--color-bg) 100%
    );
  }

  .hero[data-variant='stacked'] .hero__body {
    max-width: 720px;
  }

  /* ---------- split : 좌측 문구 + 우측 제품 이미지 ---------- */

  .hero[data-variant='split'] {
    background: var(--color-bg-subtle);
    border-bottom: 1px solid var(--color-border);
  }

  .hero[data-variant='split'] .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hero__media {
    min-width: 0;
  }

  /* prop으로 넘긴 class에는 scoped 해시가 붙지 않으므로 :global 필요 */
  .hero__media :global(.hero__img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  /* ---------- minimal : 큰 타이포만 ---------- */

  .hero[data-variant='minimal'] {
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-24) var(--space-16);
  }

  .hero[data-variant='minimal'] .hero__body {
    max-width: 900px;
  }

  .hero[data-variant='minimal'] .badge {
    background: transparent;
    padding: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero[data-variant='minimal'] .hero__title {
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    letter-spacing: -0.03em;
  }

  .hero[data-variant='minimal'] .hero__desc {
    max-width: 52ch;
  }

  @media (max-width: 880px) {
    .hero[data-variant='split'] .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .hero {
      padding-block: var(--space-16) var(--space-12);
    }
  }
</style>
