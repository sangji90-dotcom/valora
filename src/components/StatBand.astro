---
import siteConfig from '../../site.config';

/**
 * ============================================================
 *  숫자 띠 — 발로라 전용
 * ============================================================
 *  ⚠ 이 컴포넌트는 발로라에만 있습니다. 템플릿에는 넣지 마세요.
 *
 *  커머스 사이트가 "누적 판매 30만개"를 박아두는 자리입니다.
 *  우리는 팔지 않으므로 대신 **도입했을 때 줄어드는 양**을 둡니다.
 *  ESG 담당자가 보고서에 옮겨 적을 숫자라서, 판매량보다 이쪽이
 *  이 고객층에는 더 직접적으로 먹힙니다.
 *
 *  ⚠ 기준 수량을 반드시 함께 표시합니다.
 *    "80kg 절감"만 크게 써두면 무슨 기준인지 알 수 없고,
 *    그 자체로 과장 표시가 됩니다.
 * ============================================================
 */

const stats = siteConfig.stats;
---

{
  stats && stats.items.length > 0 && (
    <section class="stats" aria-label={stats.title}>
      <div class="container">
        <div class="stats__head" data-reveal>
          <h2 class="stats__title">{stats.title}</h2>
          {stats.basis && <p class="stats__basis">{stats.basis}</p>}
        </div>

        <dl class="stats__grid">
          {stats.items.map((item) => (
            <div class="stats__item" data-reveal>
              <dt class="stats__label">{item.label}</dt>
              <dd class="stats__value">
                {item.value}
                <span class="stats__unit">{item.unit}</span>
              </dd>
              {item.note && <p class="stats__note">{item.note}</p>}
            </div>
          ))}
        </dl>

        {stats.disclaimer && <p class="stats__disclaimer">{stats.disclaimer}</p>}
      </div>
    </section>
  )
}

<style>
  .stats {
    padding-block: var(--space-24);
    background:
      linear-gradient(180deg, var(--color-bg), var(--color-bg-subtle));
    border-block: 1px solid var(--color-border);
  }

  .stats__head {
    margin-bottom: var(--space-12);
    max-width: 40rem;
  }

  .stats__title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .stats__basis {
    margin: 0;
    color: var(--color-text-muted);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-8);
    margin: 0;
  }

  .stats__item {
    padding: var(--space-8) var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .stats__label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .stats__value {
    margin: var(--space-3) 0 0;
    font-size: var(--text-4xl);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }

  .stats__unit {
    margin-left: 0.15em;
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .stats__note {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .stats__disclaimer {
    margin: var(--space-8) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
