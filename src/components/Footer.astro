---
import siteConfig from '../../site.config';
import { getTerms } from '../lib/terms';
import { companyAddress, companyName, localeFromPath, localePath, ps } from '../lib/i18n';

/** 주소에서 읽은 현재 언어 */
const locale = localeFromPath(Astro.url.pathname);
import { getCategoriesWithCount } from '../lib/products';

/** 주소에서 언어를 읽어 화면 문구를 고릅니다 (i18n.ts 참고) */
const T = getTerms(localeFromPath(Astro.url.pathname));

const categories = await getCategoriesWithCount();
const year = new Date().getFullYear();
const { contact } = siteConfig;

/**
 * 내부 링크에 언어 접두어를 붙입니다.
 * ⚠ 이걸 빠뜨리면 /en/ 페이지의 링크가 한국어 쪽으로 돌아갑니다.
 *   (빌드는 멀쩡히 통과합니다 — 눈으로만 잡히는 종류입니다)
 */
const L = (p: string) => localePath(p, localeFromPath(Astro.url.pathname));

/** 설정 본문에서 현재 언어를 꺼냅니다 (i18n.ts 의 Localized 참고) */
const S = (v: Parameters<typeof ps>[0]) => ps(v, localeFromPath(Astro.url.pathname));
---

<footer class="footer">
  <div class="container footer__grid">
    <div>
      <p class="footer__brand">{companyName(locale)}</p>
      <p class="footer__muted">{S(siteConfig.tagline)}</p>
    </div>

    <nav class="footer__col" aria-label={T.ui.categoriesTitle}>
      <p class="footer__head">{T.item}</p>
      {
        categories.map((c) => (
          <a href={L(`/products/category/${c.id}/`)} class="footer__link">
            {S(c.label)}
          </a>
        ))
      }
    </nav>

    <div class="footer__col">
      <p class="footer__head">{T.ui.contactLabel}</p>
      <a href={`tel:${contact.phone.replace(/-/g, '')}`} class="footer__link">{contact.phone}</a>
      <a href={`mailto:${contact.email}`} class="footer__link">{contact.email}</a>
      <p class="footer__muted footer__address">{companyAddress(locale)}</p>
    </div>
  </div>

  <div class="container footer__bottom">
    <p class="footer__legal">
      {T.ui.ceoLine(contact.ceo, contact.businessNumber)}
    </p>
    <p class="footer__legal">
      © {year} {companyName(locale)}. All rights reserved.
      <a href={L("/privacy/")} class="footer__legal-link">{T.ui.privacyPolicy}</a>
    </p>

    {/* 국내 사이트 관행 — 이메일 주소 자동 수집을 거부한다는 표시 */}
    <p class="footer__legal footer__notice">
      {T.ui.emailNotice}
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-subtle);
    padding-block: var(--space-12) var(--space-8);
    margin-top: var(--space-24);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.4fr;
    gap: var(--space-8);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__brand {
    font-weight: 700;
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .footer__head {
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  .footer__link {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--dur) var(--ease);
  }

  .footer__link:hover {
    color: var(--color-accent);
  }

  .footer__muted {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  .footer__address {
    margin-top: var(--space-2);
    line-height: 1.5;
  }

  .footer__bottom {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .footer__legal {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
  }

  .footer__legal-link {
    margin-left: var(--space-3);
    text-decoration: underline;
  }

  .footer__notice {
    flex-basis: 100%;
    margin-top: var(--space-3);
    line-height: 1.6;
    /*
     * ⚠ opacity 로 흐리게 만들지 마세요.
     *   opacity: 0.75 를 걸었더니 12px 글자가 3.24:1 이 되어
     *   AA(4.5:1) 미달이었습니다. 덜 중요해 보이게 하려면
     *   크기와 위치로 하고, 색은 대비를 지키는 값을 씁니다.
     */
  }

  @media (max-width: 720px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
