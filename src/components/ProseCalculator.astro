---
/**
 * ============================================================
 *  절감량 계산기 — 동작과 모양
 * ============================================================
 *  마크업은 Portable Text 렌더러(src/lib/sanity/portable-text.ts)가
 *  본문 안에 만들어 넣습니다. 이 컴포넌트는 그 마크업에 붙는
 *  스크립트와 스타일만 담당합니다.
 *
 *  본문에 계산기를 넣을 수 있는 페이지(회사소개, 제품 상세)에 두세요.
 *  계산기가 없는 페이지에 있어도 아무 일도 하지 않습니다.
 *
 *  ⚠ 스타일은 is:global 이어야 합니다.
 *    본문은 set:html 로 들어오기 때문에 Astro의 scoped 해시가 붙지 않습니다.
 * ============================================================
 */
---

<script>
  /**
   * 수량을 바꾸면 절감량을 다시 계산합니다.
   *
   * 설계 —
   *  - HTML에는 이미 기준 수량에 대한 값이 들어 있습니다. 이 스크립트가
   *    막히거나 실패해도 표는 그대로 읽힙니다.
   *  - 계수는 data-min / data-max 에 **기준 수량당 값**으로 들어 있습니다.
   *  - 숫자 포맷은 서버(renderCalculator)와 같은 규칙을 씁니다.
   */
  const format = (n: number) => {
    const rounded = Math.round(n * 10) / 10;
    return rounded.toLocaleString('ko-KR', { maximumFractionDigits: 1 });
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-calc]')) {
    const input = root.querySelector<HTMLInputElement>('[data-calc-input]');
    const outs = root.querySelectorAll<HTMLElement>('[data-calc-out]');
    const base = Number(root.dataset.base);

    if (!input || outs.length === 0 || !Number.isFinite(base) || base <= 0) continue;

    const update = () => {
      const qty = Number(input.value);

      // 빈 칸이나 음수는 계산하지 않고 직전 값을 유지합니다.
      // 0으로 만들어 "절감량 0"을 보여주면 오해를 삽니다.
      if (!Number.isFinite(qty) || qty <= 0) return;

      const factor = qty / base;

      for (const out of outs) {
        const min = Number(out.dataset.min);
        const maxRaw = out.dataset.max;
        if (!Number.isFinite(min)) continue;

        const lo = min * factor;
        const max = maxRaw === undefined ? null : Number(maxRaw);

        out.textContent =
          max !== null && Number.isFinite(max) && max !== min
            ? `${format(lo)}~${format(max * factor)}`
            : format(lo);
      }
    };

    input.addEventListener('input', update);
    // 브라우저가 값을 복원한 경우(뒤로가기 등)를 위해 한 번 맞춰둡니다
    update();
  }
</script>

<style is:global>
  .calc {
    margin: var(--space-5) 0;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
  }

  .calc__title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
  }

  .calc__field {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .calc__label {
    font-weight: 600;
  }

  .calc__input-wrap {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .calc__input {
    width: 10rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font: inherit;
    font-variant-numeric: tabular-nums;
    text-align: right;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .calc__input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .calc__unit-label {
    color: var(--color-text-muted);
  }

  /* 본문 표 스타일을 그대로 쓰되, 값 칸만 숫자에 맞춥니다 */
  .calc__table {
    width: 100%;
    border-collapse: collapse;
  }

  .calc__table th,
  .calc__table td {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: baseline;
  }

  .calc__table tr:last-child th,
  .calc__table tr:last-child td {
    border-bottom: 0;
  }

  .calc__table td {
    text-align: right;
    white-space: nowrap;
  }

  .calc__note {
    display: block;
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .calc__value {
    font-size: var(--text-lg);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .calc__unit {
    color: var(--color-text-muted);
  }

  .calc__disclaimer {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 480px) {
    .calc__input {
      width: 100%;
    }

    .calc__input-wrap {
      flex: 1 1 100%;
    }
  }
</style>
