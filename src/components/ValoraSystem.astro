---
import siteConfig from '../../site.config';
import BrandIcon from './BrandIcon.astro';

/**
 * ============================================================
 *  VALORA SYSTEM — 발로라 전용 (요청서 6번)
 * ============================================================
 *  ⚠ 이 컴포넌트는 발로라에만 있습니다. 템플릿에는 넣지 마세요.
 *
 *  제품을 나열하지 않고 **이어지는 하나의 체계**로 보여줍니다.
 *  캡슐을 사면 담을 것이 필요하고, 담으면 보관할 것이 필요하고,
 *  보관하면 꺼낼 것이 필요하다 — 이 순서 자체가 제품 라인업의
 *  확장 근거입니다.
 *
 *  ⚠ CARRY·STORE 는 아직 개발 중입니다. 도식은 형태를 단순화한
 *    선 그림이고 실제 제품 사진이 아닙니다. 사진이 도착하면
 *    이 섹션은 사진으로 교체하고 도식은 HOW IT WORKS 에만 남깁니다.
 * ============================================================
 */

const sys = siteConfig.productSystem;
---

{
  sys && sys.items.length > 0 && (
    <section class="sys section" aria-label={sys.title}>
      <div class="container">
        <div class="section__head" data-reveal>
          <h2 class="section__title">{sys.title}</h2>
          {sys.lead && <p class="section__desc">{sys.lead}</p>}
        </div>

        <ol class="sys__list">
          {sys.items.map((item, i) => (
            <li class="sys__item" data-reveal>
              <div class="sys__art">
                <BrandIcon name={item.icon} />
              </div>
              <p class="sys__no">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="sys__key">{item.key}</h3>
              <p class="sys__label">{item.label}</p>
              {item.note && <p class="sys__note">{item.note}</p>}
            </li>
          ))}
        </ol>

        {sys.disclaimer && <p class="sys__disclaimer">{sys.disclaimer}</p>}
      </div>
    </section>
  )
}

<style>
  .sys__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sys__item {
    position: relative;
    text-align: center;
  }

  /*
   * 항목 사이의 화살표 — 나열이 아니라 "이어진다"는 것이 요점입니다.
   * ⚠ 짧은 점선으로 해봤더니 아이콘 사이에 떠 있는 부스러기처럼
   *   보였습니다. 방향이 보이는 화살표가 의도를 더 잘 전합니다.
   */
  .sys__item + .sys__item::before {
    content: '→';
    position: absolute;
    top: 46px;
    left: calc(var(--space-6) * -0.5);
    transform: translateX(-50%);
    font-size: var(--text-lg);
    line-height: 1;
    color: var(--color-text-muted);
    opacity: 0.55;
  }

  .sys__art {
    width: 112px;
    margin: 0 auto var(--space-5);
  }

  .sys__no {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }

  .sys__key {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-wide);
  }

  .sys__label {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .sys__note {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    opacity: 0.85;
  }

  .sys__disclaimer {
    margin: var(--space-12) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (max-width: 880px) {
    .sys__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8) var(--space-4);
    }

    /* 2열이 되면 가로 연결선이 줄을 건너뛰어 어긋납니다 */
    .sys__item + .sys__item::before {
      display: none;
    }

    .sys__art {
      width: 84px;
      margin-bottom: var(--space-4);
    }

    .sys__key {
      font-size: var(--text-base);
    }
  }
</style>
