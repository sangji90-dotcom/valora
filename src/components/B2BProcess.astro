---
import siteConfig from '../../site.config';
import { getTerms } from '../lib/terms';
import { localeFromPath, localePath, ps } from '../lib/i18n';

/**
 * ============================================================
 *  B2B 도입 절차 — 발로라 전용 (요청서 12·13번)
 * ============================================================
 *  ⚠ 이 컴포넌트는 발로라에만 있습니다. 템플릿에는 넣지 마세요.
 *
 *  이 사이트에는 장바구니도 결제도 없습니다. 그래서 방문자가
 *  "그래서 어떻게 사는 거지" 에서 멈춥니다. 그 자리를 메우는
 *  섹션이라, 마지막이 반드시 문의로 이어져야 합니다.
 *
 *  ⚠ 가격표를 넣지 마세요. 수량·납기 조건까지만 적습니다.
 *    결제가 붙는 순간 통신판매업 신고·PG 심사·개인정보 보관
 *    책임이 생기고, 월 0원/무유지보수 구조가 깨집니다.
 * ============================================================
 */

const b2b = siteConfig.b2b;
const T = getTerms(localeFromPath(Astro.url.pathname));

/** 설정 본문에서 현재 언어를 꺼냅니다 (i18n.ts 의 Localized 참고) */
const S = (v: Parameters<typeof ps>[0]) => ps(v, localeFromPath(Astro.url.pathname));

/** 내부 링크에 언어 접두어를 붙입니다 (i18n.ts 참고) */
const L = (p: string) => localePath(p, localeFromPath(Astro.url.pathname));
---

{
  b2b && b2b.steps.length > 0 && (
    <section class="b2b section" id="b2b" aria-label={S(b2b.title)}>
      <div class="container">
        <div class="section__head" data-reveal>
          <h2 class="section__title">{S(b2b.title)}</h2>
          {b2b.lead && <p class="section__desc">{S(b2b.lead)}</p>}
        </div>

        <ol class="b2b__steps">
          {b2b.steps.map((step, i) => (
            <li class="b2b__step" data-reveal>
              <p class="b2b__no">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="b2b__label">{S(step.label)}</h3>
              <p class="b2b__body">{S(step.body)}</p>
              {/*
                걸리는 시간은 있는 단계에만 붙습니다.
                모든 칸을 채우려고 "즉시" 같은 말을 넣으면
                지킬 수 없는 약속이 됩니다.
              */}
              {step.duration && <p class="b2b__dur">{S(step.duration)}</p>}
            </li>
          ))}
        </ol>

        {b2b.terms && b2b.terms.length > 0 && (
          <dl class="b2b__terms" data-reveal>
            {b2b.terms.map((t) => (
              <div class="b2b__term">
                <dt class="b2b__termLabel">{S(t.label)}</dt>
                <dd class="b2b__termValue">{S(t.value)}</dd>
              </div>
            ))}
          </dl>
        )}

        <div class="b2b__cta" data-reveal>
          <a href={L('/contact/')} class="btn btn--primary">
            {b2b.ctaLabel ? S(b2b.ctaLabel) : T.ui.contactCta}
          </a>
        </div>
      </div>
    </section>
  )
}

<style>
  /* ---------- 단계 ---------- */

  .b2b__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .b2b__step {
    position: relative;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  /*
   * 단계 사이를 잇는 선. 순서가 있다는 걸 보여주는 유일한 장치라
   * 3열 기준 각 줄의 첫 칸 앞에는 붙이지 않습니다.
   */
  .b2b__step + .b2b__step::before {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(var(--space-6) * -1);
    width: var(--space-6);
    height: 1px;
    background: var(--color-border);
  }

  .b2b__step:nth-child(3n + 1)::before {
    display: none;
  }

  .b2b__no {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
  }

  .b2b__label {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
  }

  .b2b__body {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
    word-break: keep-all;
  }

  .b2b__dur {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text);
    opacity: 0.75;
  }

  /* ---------- 거래 조건 ---------- */

  .b2b__terms {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-5) var(--space-8);
    margin: var(--space-8) 0 0;
    padding: var(--space-8) var(--space-6);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .b2b__term {
    min-width: 0;
  }

  .b2b__termLabel {
    margin: 0 0 var(--space-1);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }

  .b2b__termValue {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.7;
    word-break: keep-all;
  }

  .b2b__cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-8);
  }

  @media (max-width: 880px) {
    .b2b__steps {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
    }

    /* 2열이 되면 줄바꿈 위치가 달라지므로 잇는 선 규칙도 바뀝니다 */
    .b2b__step:nth-child(3n + 1)::before {
      display: block;
    }

    .b2b__step:nth-child(2n + 1)::before {
      display: none;
    }

    .b2b__step + .b2b__step::before {
      left: calc(var(--space-4) * -1);
      width: var(--space-4);
    }

    .b2b__step {
      padding: var(--space-5);
    }

    .b2b__terms {
      margin-top: var(--space-8);
      padding: var(--space-6) var(--space-5);
      gap: var(--space-4);
    }
  }

  @media (max-width: 520px) {
    .b2b__steps {
      grid-template-columns: 1fr;
    }

    /* 1열에서는 가로선이 의미가 없습니다 */
    .b2b__step::before {
      display: none !important;
    }
  }
</style>
