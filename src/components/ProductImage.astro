---
import { Image } from 'astro:assets';
import type { ProductImage } from '../lib/content/image';
import { sanityImageUrl, sanitySrcSet } from '../lib/content/image';

interface Props {
  image: ProductImage;
  alt: string;
  widths: number[];
  sizes: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  image,
  alt,
  widths,
  sizes,
  loading = 'lazy',
  class: className,
} = Astro.props;

/**
 * 로컬 이미지는 Astro가 빌드 시 WebP로 변환하고,
 * 원격(CMS) 이미지는 Sanity CDN의 변환 파라미터를 사용합니다.
 * 호출하는 쪽은 둘의 차이를 몰라도 됩니다.
 */
const maxWidth = Math.max(...widths);

/**
 * 대체 텍스트 우선순위 —
 *   1) CMS에서 담당자가 직접 적은 값
 *   2) 호출한 쪽이 넘긴 기본값 (보통 제품명)
 *
 * 고객사가 Studio에서 공들여 적은 값이 화면에 안 쓰이면
 * "적어봐야 소용없네"가 되어 아무도 안 적게 됩니다.
 */
const finalAlt = (image.kind === 'remote' && image.alt?.trim()) || alt;
---

{
  image.kind === 'local' ? (
    <Image
      src={image.src}
      alt={finalAlt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      class={className}
    />
  ) : (
    /*
     * ⚠ style 속성을 쓰지 마세요.
     *   CSP를 해시 기반으로 운영하고 있어서 style **속성**은 허용할 수단이 없습니다
     *   ('unsafe-hashes'를 열지 않는 한). 넣으면 브라우저가 조용히 무시하고
     *   콘솔에만 CSP 오류가 쌓입니다. 예전에 lqip 블러를 여기에 넣었다가
     *   전량 차단되고 있었습니다. scripts/test-csp.mjs 가 재발을 막습니다.
     */
    <img
      src={sanityImageUrl(image.url, { width: maxWidth })}
      srcset={sanitySrcSet(image.url, widths)}
      sizes={sizes}
      width={image.width}
      height={image.height}
      alt={finalAlt}
      loading={loading}
      decoding="async"
      class={className}
    />
  )
}
