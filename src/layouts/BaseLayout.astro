---
import siteConfig from '../../site.config';
import SEO from '../components/SEO.astro';
import DemoBanner from '../components/DemoBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickBar from '../components/QuickBar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SEO title={title} description={description} image={image} noindex={noindex} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">본문으로 건너뛰기</a>
    <DemoBanner />
    <Header />
    {/* tabindex=-1 — 건너뛰기 링크·맨 위로 에서 포커스를 받을 수 있게 */}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <QuickBar />

    {/*
      방문자 통계 — 쿠키를 쓰지 않으므로 동의 배너가 필요 없습니다.
      토큰이 없으면 스크립트 자체를 넣지 않습니다.
    */}
    {
      siteConfig.analytics.cloudflareToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${siteConfig.analytics.cloudflareToken}"}`}
        />
      )
    }
  </body>
</html>
