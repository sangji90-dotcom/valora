---
import siteConfig from '../../site.config';
import { localeFromPath, LOCALE_TAG } from '../lib/i18n';
import SEO from '../components/SEO.astro';
import DemoBanner from '../components/DemoBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickBar from '../components/QuickBar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;

// 사이트 전체 설정이 켜져 있으면 페이지 설정과 무관하게 제외합니다
const noindexFinal = siteConfig.noindex || noindex;

/**
 * ⚠ <html lang> 은 site.config.lang 고정이 아니라 주소에서 읽습니다.
 *   /en/ 페이지가 lang="ko" 로 나가면 화면낭독기가 영문을 한국어
 *   발음으로 읽고, 검색엔진도 언어를 잘못 잡습니다.
 */
const locale = localeFromPath(Astro.url.pathname);
---

<!doctype html>
<html lang={LOCALE_TAG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/*
      JS를 끈 방문자에게만 적용되는 스타일 — 내용은 public/noscript.css 에.
      ⚠ <noscript> 안에 <style> 을 직접 쓰면 안 됩니다. Astro의 CSP 해시
        수집이 <noscript> 내부를 건너뛰어서, JS 끈 사람에게만 조용히
        차단됩니다. 외부 스타일시트는 style-src 'self' 로 통과합니다.
    */}
    <noscript><link rel="stylesheet" href="/noscript.css" /></noscript>

    <SEO title={title} description={description} image={image} noindex={noindexFinal} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">본문으로 건너뛰기</a>
    <DemoBanner />
    <Header />
    {/* tabindex=-1 — 건너뛰기 링크·맨 위로 에서 포커스를 받을 수 있게 */}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <QuickBar />

    {/*
      방문자 통계 — 쿠키를 쓰지 않으므로 동의 배너가 필요 없습니다.
      토큰이 없으면 스크립트 자체를 넣지 않습니다.
    */}
    {
      siteConfig.analytics.cloudflareToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${siteConfig.analytics.cloudflareToken}"}`}
        />
      )
    }
  </body>
</html>
