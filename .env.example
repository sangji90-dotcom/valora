# 이 파일을 .env 로 복사해서 사용하세요. .env 는 커밋하지 않습니다.

# ─────────────────────────────────────────────
# 데이터 소스: local (기본) | sanity
# ─────────────────────────────────────────────
CONTENT_SOURCE=local

# ─────────────────────────────────────────────
# CONTENT_SOURCE=sanity 일 때만 필요
# ─────────────────────────────────────────────
# SANITY_PROJECT_ID=abc12345
# SANITY_DATASET=production
# SANITY_API_VERSION=2024-01-01

# 비공개 dataset일 때만. 공개 dataset이면 비워 두세요.
# 토큰이 없으면 유출될 토큰도, 만료로 사이트가 멈출 일도 없습니다.
# SANITY_READ_TOKEN=

# 초안 문서까지 보고 싶을 때만 true. 운영 빌드에서는 켜지 마세요.
# SANITY_INCLUDE_DRAFTS=false

# ⚠️ 로컬 테스트 전용입니다. 운영에서 설정하면 빌드가 거부됩니다.
# SANITY_API_HOST=localhost:3999
